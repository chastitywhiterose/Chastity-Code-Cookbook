strict:
	gcc -Wall -ansi -pedantic main.c -o main && ./main
strip:
	gcc -Wall -ansi -pedantic main.c -o main -s
simple:
	gcc main.c -o main && ./main
clang:
	gcc -Wall -ansi -pedantic main.c -o main && ./main
tcc:
	tcc main.c -o main && ./main
zig:
	zig cc -Wall -ansi -pedantic main.c -o main && ./main
